<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Newest runtime actually installed on this machine; see the repo global.json. -->
    <RuntimeFrameworkVersion>9.0.11</RuntimeFrameworkVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>apiindex</AssemblyName>
    <RootNamespace>apiindex</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
